{
  "data_path": "../ai4i2020.csv",
  "artifact_dir": "../artifacts",
  "target_column": "Machine failure",
  "test_size": 0.2,
  "validation_size": 0.2,
  "random_seed": 42,
  "minimum_failure_recall": 0.9,
  "minimum_failure_type_recall": 0.8,
  "cross_validation_folds": 5,
  "failure_type_columns": ["TWF", "HDF", "PWF", "OSF"],
  "model_candidates": {
    "random_forest": {
      "n_estimators": 300,
      "class_weight": "balanced",
      "max_depth": null,
      "n_jobs": -1
    },
    "xgboost": {
      "n_estimators": 300,
      "max_depth": 4,
      "learning_rate": 0.05,
      "subsample": 0.9,
      "colsample_bytree": 0.9,
      "n_jobs": -1
    }
  },
  "failure_classifier": {
    "n_estimators": 400,
    "class_weight": "balanced",
    "max_depth": null,
    "n_jobs": -1
  }
}
